# Android SDK location (required). Android Studio sets this automatically.
sdk.dir=/path/to/android-sdk

# Gemini Live API credentials.
# Dev-only. Production credentials must come from the ClassEve Worker bootstrap endpoint
# (see SessionBootstrapRepository) so raw API keys never ship in the APK.
GEMINI_API_KEY=your-gemini-live-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional: classeve.com Worker base URL for remote bootstrap when auth lands.
# WORKER_URL=https://lven-api.lven.workers.dev

# Release signing. assembleRelease produces an UNSIGNED APK if any of
# these four are missing — Play Store rejects unsigned uploads. Generate
# a keystore with:
#   keytool -genkeypair -v -keystore earslate-release.keystore \
#     -alias earslate -keyalg RSA -keysize 4096 -validity 25000
# Then set:
# EARSLATE_STORE_FILE=/absolute/path/to/earslate-release.keystore
# EARSLATE_STORE_PASSWORD=...
# EARSLATE_KEY_ALIAS=earslate
# EARSLATE_KEY_PASSWORD=...
