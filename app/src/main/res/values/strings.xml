    <!-- Onboarding -->
    <string name="onboarding_kicker">EARSLATE</string>
    <string name="onboarding_welcome">Welcome</string>
    <string name="onboarding_headline">A translator that just\nlistens.</string>
    <string name="onboarding_support">Tap start. Hear nearby speech come back in your language. That\'s the whole product.</string>
    <string name="onboarding_step1_title">Microphone access</string>
    <string name="onboarding_step1_body">earslate only translates what it can hear. Android will ask once; grant it and you never see the prompt again.</string>
    <string name="onboarding_step2_title">Notifications</string>
    <string name="onboarding_step2_body">A persistent notification keeps the translator alive while the screen is off — Android requires this for microphone use in the background.</string>
    <string name="onboarding_step3_title">Quick Settings tile</string>
    <string name="onboarding_step3_body">Swipe down twice from the top of your screen, tap the pencil/edit icon, then drag \'earslate\' into your active tiles. One tap to start or stop from anywhere.</string>
    <string name="onboarding_step4_title">Earbuds recommended</string>
    <string name="onboarding_step4_body">Bluetooth or wired earbuds dramatically reduce echo. Speaker mode works but is less reliable in noisy spaces.</string>

