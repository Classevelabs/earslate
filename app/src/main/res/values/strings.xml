    <!-- Audio-egress prominent disclosure (Google Play User Data policy) -->
    <string name="audio_disclosure_title">How your audio is used</string>
    <string name="audio_disclosure_body">To translate, earslate sends the audio it captures to Google\'s Gemini service over an encrypted connection. Google processes that audio to produce the translation in real time and may retain it under Google\'s terms. earslate stores no audio of its own. Tap I agree to allow this, or open our privacy policy to learn more.</string>
    <string name="audio_disclosure_agree">I agree</string>
    <string name="audio_disclosure_decline">Not now</string>
    <string name="audio_disclosure_privacy">Privacy policy</string>

