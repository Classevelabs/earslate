<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Earslate" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/earslate_bg_canvas</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- StartActivity is in front only to start a session: nothing of it is drawn. -->
    <style name="Theme.Earslate.Start" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
